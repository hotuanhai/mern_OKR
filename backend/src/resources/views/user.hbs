<div class="mt-4">
    <div class="row">
        {{#each courses}}
            <div class="col-sm-6 col-lg-4 mb-4">
                <div class="card h-100"> <!-- Added h-100 for equal height cards -->
                    <a href="pic/listtask/{{this._id}}">
                        <!-- Correcting the image src -->
                        {{!-- <img class="card-img-top" src="{{this.image}}" alt="{{this.name}}" style="object-fit: cover; height: 200px;"> --}}
                    </a>
                    <div class="card-body d-flex flex-column"> <!-- Added flex-column for flexible content -->
                        <!-- Link for title -->
                        <a href="pic/listtask/{{this._id}}">
                            <h5 class="card-title">{{this.name}}</h5>
                        </a>

                        <p class="card-text">{{this.email}}</p>
                        <a href="pic/listtask/{{this._id}}" class="btn btn-primary mt-auto">Go Work</a> <!-- Added mt-auto for button positioning -->                    
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
</div>

  <!-- Script cho Modal và fetch dữ liệu chi tiết -->
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.2/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>